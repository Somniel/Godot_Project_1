max-line-length: 100

# Disable rules that don't fit the project's patterns
disable:
  - class-definitions-order
  - max-public-methods
  - max-file-lines
  - private-method-call
  - no-else-return
  - no-elif-return
  - max-returns
  - function-arguments-number
  - class-variable-name
  - function-preload-variable-name
